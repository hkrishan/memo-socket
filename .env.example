# Server
PORT=3031
NODE_ENV=development

# Must match memo-api's JWT_SECRET (the socket server verifies memo-api access tokens)
JWT_SECRET=

# Valkey — optional in development; the server degrades to single-instance
# without an adapter when unreachable
CACHE_URL=127.0.0.1:6379
CACHE_CLUSTER_MODE=false
CACHE_TLS=false

# memo-api base URL including the /v1 prefix
API_URL=http://192.168.1.111:3026/v1

# Shared secret for internal server-to-server calls — same value as
# INTERNAL_SECRET in memo-api/.env (generate: openssl rand -hex 32)
INTERNAL_SECRET=

# DynamoDB message storage
AWS_REGION=eu-north-1
DYNAMO_TABLE=memo-chat-messages
# For dynamodb-local, set the endpoint (real AWS is used when unset):
# DYNAMO_ENDPOINT=http://127.0.0.1:8000
# Explicit AWS credentials — leave unset to use the SDK default chain
# (~/.aws/credentials, instance roles, ...). dynamodb-local accepts any values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
